# Live-background capture configuration for the wall-kiosk theme.
#
# This file is sourced by the wall-kiosk-capture systemd service. Edit the
# values here to point the live wallpaper at a different kiosk/dashboard or
# change the capture resolution, then reload the unit:
#
#   systemctl --user daemon-reload
#   systemctl --user restart wall-kiosk-capture.timer
#
# The same variables are also honored when the capture script is run by hand
# (set them in your shell; the script's built-in defaults match this file).

WALL_KIOSK_URL=https://example.invalid/kiosk-dashboard
WALL_KIOSK_WIDTH=2560
WALL_KIOSK_HEIGHT=1440
WALL_KIOSK_SETTLE=5
