// Minimal niri config for the Omarchy niri-on-Ubuntu port.

input {
    keyboard {
        xkb {
            layout "us"
        }
    }
    touchpad {
        tap
        natural-scroll
    }
}

spawn-at-startup "%h/.local/bin/omarchy-shell-niri"

binds {
    // === Omabuntu-compatible shortcuts (ported from omakub gnome hotkeys.sh) ===
    // Launchers
    Mod+Space       { spawn "omakub-menu-app"; }
    Mod+Alt+Space   { spawn "omakub-menu"; }
    Mod+Shift+Space { spawn "omakub-menu"; }

    // System / menus
    Mod+Escape          { spawn "omakub-menu" "system"; }
    Mod+Ctrl+Space      { spawn "omakub-menu" "background"; }
    Mod+Shift+Ctrl+Space { spawn "omakub-menu" "theme"; }

    // Window management
    Mod+W { close-window; }
    Mod+Shift+F { toggle-window-floating; }
    Mod+F { fullscreen-window; }
    Mod+Up { maximize-column; }
    Mod+Shift+Slash { show-hotkey-overlay; }

    // Apps
    Mod+Return      { spawn "xdg-terminal-exec"; }
    Mod+Ctrl+Return { spawn "alacritty" "-e" "herdr"; }
    Mod+Alt+Return  { spawn "xdg-terminal-exec" "bash" "-c" "tmux attach || tmux new -s Work"; }
    Mod+Shift+B     { spawn "omakub-launch-browser" "--new-window"; }
    Mod+Shift+N     { spawn "omakub-launch-editor"; }

    // Navigation (niri column model)
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+Shift+H { move-column-left; }
    Mod+Shift+L { move-column-right; }
    Mod+Shift+J { move-window-down; }
    Mod+Shift+K { move-window-up; }

    // Workspaces
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+WheelScrollDown { focus-workspace-down; }
    Mod+WheelScrollUp   { focus-workspace-up; }
}
